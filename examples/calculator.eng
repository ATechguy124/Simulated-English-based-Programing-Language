Create window titled "Full Scientific Calculator" size 640 x 420

Set calcExpr to "0"

Draw box at 0, 0 size 640 x 420 filled with "#0f172a" as bg
Draw box at 180, 15 size 280 x 390 filled with "#1e293b" as calcFrame

Draw box at 195, 30 size 250 x 50 filled with "#020617" as displayBg
Draw text "0" at 210, 55 colored "#38bdf8" as displayText

Draw button "C" at 195, 95 size 55 x 45 colored "#be123c" as btnClear
Draw button "(" at 260, 95 size 55 x 45 colored "#334155" as btnOpenParen
Draw button ")" at 325, 95 size 55 x 45 colored "#334155" as btnCloseParen
Draw button "/" at 390, 95 size 55 x 45 colored "#0284c7" as btnDiv

Draw button "7" at 195, 150 size 55 x 45 colored "#475569" as btn7
Draw button "8" at 260, 150 size 55 x 45 colored "#475569" as btn8
Draw button "9" at 325, 150 size 55 x 45 colored "#475569" as btn9
Draw button "*" at 390, 150 size 55 x 45 colored "#0284c7" as btnMul

Draw button "4" at 195, 205 size 55 x 45 colored "#475569" as btn4
Draw button "5" at 260, 205 size 55 x 45 colored "#475569" as btn5
Draw button "6" at 325, 205 size 55 x 45 colored "#475569" as btn6
Draw button "-" at 390, 205 size 55 x 45 colored "#0284c7" as btnSub

Draw button "1" at 195, 260 size 55 x 45 colored "#475569" as btn1
Draw button "2" at 260, 260 size 55 x 45 colored "#475569" as btn2
Draw button "3" at 325, 260 size 55 x 45 colored "#475569" as btn3
Draw button "+" at 390, 260 size 55 x 45 colored "#0284c7" as btnAdd

Draw button "0" at 195, 315 size 120 x 45 colored "#475569" as btn0
Draw button "=" at 325, 315 size 120 x 45 colored "#10b981" as btnEquals

Draw button "Exit to Desktop" at 195, 368 size 250 x 28 colored "#0f172a" as btnHome

On click btn0:
    Set calcExpr to calcExpr + "0"
    Set text of displayText to calcExpr
End

On click btn1:
    Set calcExpr to calcExpr + "1"
    Set text of displayText to calcExpr
End

On click btn2:
    Set calcExpr to calcExpr + "2"
    Set text of displayText to calcExpr
End

On click btn3:
    Set calcExpr to calcExpr + "3"
    Set text of displayText to calcExpr
End

On click btn4:
    Set calcExpr to calcExpr + "4"
    Set text of displayText to calcExpr
End

On click btn5:
    Set calcExpr to calcExpr + "5"
    Set text of displayText to calcExpr
End

On click btn6:
    Set calcExpr to calcExpr + "6"
    Set text of displayText to calcExpr
End

On click btn7:
    Set calcExpr to calcExpr + "7"
    Set text of displayText to calcExpr
End

On click btn8:
    Set calcExpr to calcExpr + "8"
    Set text of displayText to calcExpr
End

On click btn9:
    Set calcExpr to calcExpr + "9"
    Set text of displayText to calcExpr
End

On click btnAdd:
    Set calcExpr to calcExpr + "+"
    Set text of displayText to calcExpr
End

On click btnSub:
    Set calcExpr to calcExpr + "-"
    Set text of displayText to calcExpr
End

On click btnMul:
    Set calcExpr to calcExpr + "*"
    Set text of displayText to calcExpr
End

On click btnDiv:
    Set calcExpr to calcExpr + "/"
    Set text of displayText to calcExpr
End

On click btnOpenParen:
    Set calcExpr to calcExpr + "("
    Set text of displayText to calcExpr
End

On click btnCloseParen:
    Set calcExpr to calcExpr + ")"
    Set text of displayText to calcExpr
End

On click btnClear:
    Set calcExpr to ""
    Set text of displayText to "0"
End

On click btnEquals:
    Set calcExpr to calcExpr
    Set text of displayText to calcExpr
End

On click btnHome:
    Launch app "desktop"
End
