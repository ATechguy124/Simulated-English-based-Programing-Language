Create window titled "EnglishOS Pro Workspace" size 640 x 420

Set sysUptime to 0

# Wallpaper / Glass Background
Draw box at 0, 0 size 640 x 420 filled with "#0b0f19" as desktopBg
Draw text "EnglishOS v5.2 Enterprise" at 25, 28 colored "#475569" as desktopHeader

# Left Navigation Dock Panel
Draw box at 20, 50 size 150 x 310 filled with "#131c2e" as dockBg
Draw text "APPLICATIONS" at 35, 72 colored "#64748b" as dockTitle

Draw button "🧮 Calculator" at 30, 90 size 130 x 42 colored "#1e293b" as appCalcIcon
Draw button "💻 Diagnostics" at 30, 142 size 130 x 42 colored "#1e293b" as appSysIcon
Draw button "🐍 Python WASM" at 30, 194 size 130 x 42 colored "#1e293b" as appPyIcon

# Center Widget Cards
Draw box at 185, 50 size 435 x 180 filled with "#131c2e" as cardMain
Draw text "System Workspace" at 205, 78 colored "#38bdf8" as widgetTitle
Draw text "Engine State: EnglishScript WASM Active" at 205, 110 colored "#94a3b8" as w1
Draw text "Python Runtime: Pyodide v0.26 Interop Ready" at 205, 135 colored "#94a3b8" as w2
Draw text "Memory Allocation: Dynamic Virtual Registers" at 205, 160 colored "#94a3b8" as w3

Draw box at 185, 242 size 435 x 118 filled with "#131c2e" as cardStats
Draw text "Performance Monitor" at 205, 266 colored "#10b981" as perfTitle
Draw text "Status: Nominal" at 205, 298 colored "#cbd5e1" as perfStatus

# Bottom Taskbar & Start Shell
Draw box at 0, 375 size 640 x 45 filled with "#030712" as taskbar
Draw button "⚡ Menu" at 12, 383 size 75 x 30 colored "#2563eb" as startBtn
Draw text "System Online" at 100, 398 colored "#10b981" as sysStatus
Draw text "Uptime: 0s" at 540, 398 colored "#f8fafc" as sysClock

# Overlay Start Menu
Draw box at 12, 210 size 170 x 160 filled with "#1e293b" as startMenu
Draw button "Calculator" at 22, 220 size 150 x 30 colored "#334155" as menuCalcBtn
Draw button "Diagnostics" at 22, 255 size 150 x 30 colored "#334155" as menuSysBtn
Draw button "Python App" at 22, 290 size 150 x 30 colored "#334155" as menuPyBtn
Draw button "Dismiss" at 22, 330 size 150 x 25 colored "#e11d48" as menuCloseBtn
Hide startMenu

# Event Handlers
On click startBtn:
    Show startMenu
End

On click menuCloseBtn:
    Hide startMenu
End

On click appCalcIcon:
    Launch app "calculator"
End

On click menuCalcBtn:
    Launch app "calculator"
End

On click appSysIcon:
    Launch app "sysinfo"
End

On click menuSysBtn:
    Launch app "sysinfo"
End

On click appPyIcon:
    Launch app "python_app"
End

On click menuPyBtn:
    Launch app "python_app"
End

On tick:
    Increase sysUptime by 1
    Set text of sysClock to "Uptime: " + sysUptime + "s"
End
