Create window titled "EnglishOS v5.0 Enterprise" size 640 x 420

# --- SYSTEM STATE ---
Set sysUptime to 0
Set activeApp to "Desktop Workspace"

# --- DESKTOP ENVIRONMENT ---
Draw box at 0, 0 size 640 x 420 filled with "#090d16" as desktopBg
Draw text "EnglishOS v5.0 — Multi-App Workstation Environment" at 20, 25 colored "#334155" as desktopHeader

# Desktop Quick Launch Shortcuts
Draw button "🧮 Calculator" at 30, 60 size 130 x 70 colored "#1e293b" as appCalcIcon
Draw button "💻 Diagnostics" at 30, 150 size 130 x 70 colored "#1e293b" as appSysIcon
Draw button "🐍 Python App" at 30, 240 size 130 x 70 colored "#1e293b" as appPyIcon

# System Information Widget
Draw box at 180, 60 size 430 x 300 filled with "#111827" as widgetBg
Draw text "System Overview" at 200, 90 colored "#38bdf8" as widgetTitle
Draw text "Status: System Nominal" at 200, 125 colored "#22c35e" as widgetStatus
Draw text "Engine: EnglishScript v5.0" at 200, 155 colored "#cbd5e1" as widgetEngine
Draw text "Active Program: Desktop Shell" at 200, 185 colored "#94a3b8" as widgetApp

# --- SYSTEM TASKBAR ---
Draw box at 0, 380 size 640 x 40 filled with "#020617" as taskbar
Draw button "⌘ Start" at 8, 385 size 80 x 30 colored "#2563eb" as startBtn
Draw text "System Active" at 105, 404 colored "#64748b" as sysTray
Draw text "Uptime: 0s" at 530, 404 colored "#f8fafc" as sysClock

# Start Menu Dropdown
Draw box at 8, 200 size 170 x 175 filled with "#1e293b" as startMenu
Draw button "Launch Calculator" at 18, 210 size 150 x 32 colored "#334155" as menuCalcBtn
Draw button "Launch Diagnostics" at 18, 250 size 150 x 32 colored "#334155" as menuSysBtn
Draw button "Launch Python App" at 18, 290 size 150 x 32 colored "#334155" as menuPyBtn
Draw button "Close Menu" at 18, 330 size 150 x 32 colored "#be123c" as menuCloseBtn
Hide startMenu

# --- EVENT HANDLERS ---
On click startBtn:
    Show startMenu
End

On click menuCloseBtn:
    Hide startMenu
End

On click appCalcIcon:
    Launch app "calculator"
End

On click menuCalcBtn:
    Launch app "calculator"
End

On click appSysIcon:
    Launch app "sysinfo"
End

On click menuSysBtn:
    Launch app "sysinfo"
End

On click appPyIcon:
    Launch app "python_app"
End

On click menuPyBtn:
    Launch app "python_app"
End

# --- SYSTEM HEARTBEAT ---
On tick:
    Increase sysUptime by 1
    Set text of sysClock to "Uptime: " + sysUptime + "s"
End
