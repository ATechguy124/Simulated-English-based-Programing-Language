Create window titled "EnglishOS Terminal" size 640 x 420

Set termOutput1 to "EnglishOS Shell [v1.0.0 WASM]"
Set termOutput2 to "Type or select a command action below."
Set termOutput3 to "> status"
Set termOutput4 to "System status: OK"

# Window Frame
Draw box at 0, 0 size 640 x 420 filled with "#020617" as bg
Draw box at 20, 20 size 600 x 315 filled with "#090d16" as termScreen

# Terminal Window Controls
Draw box at 20, 20 size 600 x 30 filled with "#1e293b" as termHeader
Draw text "root@english-os:~#" at 35, 35 colored "#94a3b8" as headerText

# Terminal Output Lines
Draw text "EnglishOS Shell [v1.0.0 WASM]" at 35, 70 colored "#22c55e" as line1
Draw text "Type or select a command action below." at 35, 100 colored "#64748b" as line2
Draw text "> system --info" at 35, 130 colored "#38bdf8" as line3
Draw text "Ready." at 35, 160 colored "#f8fafc" as line4

# Quick Command Bar
Draw button "> help" at 20, 350 size 90 x 38 colored "#1e293b" as btnHelp
Draw button "> sysinfo" at 120, 350 size 95 x 38 colored "#1e293b" as btnSys
Draw button "> python" at 225, 350 size 95 x 38 colored "#1e293b" as btnPy
Draw button "> clear" at 330, 350 size 85 x 38 colored "#be123c" as btnClear
Draw button "Exit to Desktop" at 430, 350 size 190 x 38 colored "#0284c7" as btnHome

# --- EVENT HANDLERS ---
On click btnHelp:
    Set text of line2 to "> help"
    Set text of line3 to "Commands: sysinfo, python, clear, exit"
    Set text of line4 to "Execute commands via shortcut keys."
End

On click btnSys:
    Set text of line2 to "> sysinfo"
    Set text of line3 to "Host: CodePen WASM Canvas | Arch: Virtual VM"
    Set text of line4 to "Memory: 64MB Alloc | Engine: Active"
End

On click btnPy:
    Run python "import sys; f'Python {sys.version.split()[0]} via Pyodide'" as pyOut
    Set text of line2 to "> python --version"
    Set text of line3 to "Executing WASM Runtime..."
    Set text of line4 to pyOut
End

On click btnClear:
    Set text of line2 to ""
    Set text of line3 to ""
    Set text of line4 to "Console cleared."
End

On click btnHome:
    Launch app "desktop"
End
